{
  "name": "news-bot",
  "version": "1.0.0",
  "description": "Daily news digest: RSS feeds, deduped, picked and summarized by Claude, posted to Discord.",
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test:watch": "vitest"
  },
  "keywords": [
    "rss",
    "news",
    "discord",
    "claude",
    "llm",
    "digest"
  ],
  "author": "Todd Rasband",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "commander": "^14.0.3",
    "dotenv": "^17.4.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.2",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.2",
    "@types/sanitize-html": "^2.16.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3"
  }
}
